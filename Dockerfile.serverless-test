# Local dev/test image only — NOT used to build or run the actual app.
#
# Approximates Vercel/AWS Lambda's Amazon-Linux-based runtime so
# collectors/oliveyoung/serverlessProductCollector.ts (the @sparticuz/chromium
# collector built for a possible future Vercel migration — see chat history)
# can actually be exercised on a Mac/Windows dev machine. That binary targets
# Lambda's runtime specifically and will NOT execute at all outside it
# (confirmed: `spawn ENOEXEC` on macOS) — this container is how you get a
# real answer locally instead of only finding out after deploying.
#
# Build once:
#   npm run docker:build:serverless-test
# Run a test (builds the image first if missing):
#   npm run test:serverless-crawl -- "https://www.oliveyoung.co.kr/store/goods/getGoodsDetail.do?goodsNo=<goodsNo>"
#
# On Apple Silicon this runs under QEMU emulation (x86_64 image on an arm64
# host) — noticeably slower than real Vercel hardware would be, so timing
# measured here is a conservative (worse-case) estimate, not a true one.
FROM public.ecr.aws/lambda/nodejs:22

# Headless Chromium's runtime deps — not included in the base Lambda image.
# Without these, the browser launches but immediately dies with
# "error while loading shared libraries: libnspr4.so: ...".
RUN dnf install -y \
    nss nspr atk cups-libs gtk3 \
    libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst \
    pango at-spi2-atk libXt alsa-lib mesa-libgbm \
    && dnf clean all

ENTRYPOINT ["/bin/bash"]
